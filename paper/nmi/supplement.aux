\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Deployment experiment, first run (October 2026) and rerun (3 November 2026). Relay is relayed/delivered runs; the odds ratio compares relay of plausible values on exact-route fields with other fields (registered test, task-clustered logistic regression, 95\% interval). Audit columns count runs matching each pattern.}}{2}{table.1}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Prompt variants: wrong value relayed (relayed/parsed runs) under the registered default prompt and three variants, on (a) protein tasks whose full record contradicts the value, (b) the chemistry agreement cell (three samples) and (c) coherent protein errors. The last column gives, for the two-fields variant, runs in which the stated database value matched the record (scored on (a) and (b)).}}{2}{table.2}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Repetition versus consistency: wrong molecular weight relayed (relayed/parsed runs; 60 compounds, three samples, full record). R0, weight alone; R1, a verbatim repeat field scaled with the weight; R2, the repeat left correct; B, the heavy-atom count scaled with the weight. On uncorrupted records with the repeat field present, every model answered correctly in 60 of 60 runs. Pooled discordant pairs for RC1 (R0 relayed and R1 not, against the reverse): 198 against 84, two-sided McNemar $p < 10^{-10}$; for RC3 (R2 against R0), $p < 10^{-10}$.}}{3}{table.3}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Memory probe on the 79 proteins with superseded sequences. Memory state is the model's answer, without tools, for the protein's length: current (within one residue of today's length), superseded (within one of the superseded length), either (both, where they differ by at most two) or other. Relay of the superseded value is given as relayed/runs by memory state, without a second source (full record, one sample) and with the second source shown (annotate arm, three samples); $p$ is the registered one-sided Fisher test of superseded-memory against current-memory relay with the second source.}}{3}{table.4}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Withholding harness (full record, 100 tasks per domain and condition, one sample): corrupted numeric fields and identifiers relayed (relayed/parsed runs), runs without a parseable answer, and runs answered with a value that was neither the true nor the corrupted one. The last column gives identifier relay in the annotate arm of the benchmark (summary record) for comparison; the arms differ in record format.}}{4}{table.5}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Deployment rerun (Fig.~1b, c): corrupted values relayed by field (relayed/delivered runs) and, among relayed runs, how many raised a concern.}}{6}{table.6}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces Benchmark (Extended Data Fig.~1): corrupted values relayed, runs raising a concern, and relayed runs that raised a concern (summary record, registered prompt, one sample).}}{7}{table.7}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces Override boundaries (Extended Data Fig.~2), value decreased: corrupted value relayed (relayed/parsed runs) at each corruption factor, full record, paired field scaled alike.}}{8}{table.8}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces Override boundaries (Extended Data Fig.~2), value increased: corrupted value relayed (relayed/parsed runs) at each corruption factor, full record, paired field scaled alike.}}{8}{table.9}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {10}{\ignorespaces New chemistry fields with the full record (Fig.~4a): runs raising a concern and corrupted values relayed, by field and condition.}}{9}{table.10}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {11}{\ignorespaces Agreement follow-up (Fig.~4b, c): wrong value relayed on the same 60 compounds, pooled over three samples and per sample.}}{10}{table.11}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {12}{\ignorespaces Superseded UniProt sequences (Fig.~3): superseded value relayed with the full and summary record (one sample), full-record repeats (three samples), and with AlphaFold DB as second source (annotate arm, three samples) on covered proteins, by direction of the revision, and on the uncovered protein.}}{10}{table.12}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {13}{\ignorespaces Presentation of the correction (Fig.~6): superseded value relayed on covered proteins under four presentations, pooled over three samples and per sample.}}{10}{table.13}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {14}{\ignorespaces Identity. Relay (relayed/parsed runs) on the 25 length-threshold benchmark tasks with the full record, with identity but no annotation (accession, protein name, gene, organism, length, mass, sequence), and with neither (anonymous; three samples, the first paired with the other formats); clean rows give accuracy. The last row per model gives relay of the 79 superseded sequences without a second source, with the full record and anonymously.}}{12}{table.14}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {15}{\ignorespaces Reasoning. Relay (relayed/parsed runs) at the setting used throughout and with reasoning reduced, paired by task; the Reduction column gives the reduced setting for each model (Opus 5 and Sonnet 5 otherwise ran with adaptive thinking, Gemini 4 Argon at the provider's default).}}{12}{table.15}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {16}{\ignorespaces Request settings recorded in the traces, by model as requested (the three most frequent configurations; runs counted over the benchmark and round-2 files). Settings not listed were the provider's defaults. The label thinking=adaptive is the harness's own name for its default setting; the harness sent it as an API parameter only to Anthropic models and sent no reasoning parameter to other providers, except effort=low to Gemini 4 Argon in the reasoning ablation.}}{12}{table.16}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {17}{\ignorespaces Prompt without the concerns field (summary record, first 100 tasks per domain). Relay under the registered prompt and without the concerns field; runs listing a concern under the registered prompt; runs voicing doubt in the reply text with and without the field, by the validated classifier; and the registered keyword detector without the field, a lower bound.}}{13}{table.17}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {18}{\ignorespaces Familiar duplicate field. Relay of a wrong molecular weight alone and with a verbatim copy that agrees or disagrees, under an unfamiliar (molecular\_weight\_reported) or familiar (average\_mass) field name; first sample of the earlier arms; 60 compounds.}}{13}{table.18}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {19}{\ignorespaces Revision audit of the 79 superseded sequences: class, number of proteins, number with the change at the N-terminus, and relay of the superseded value pooled over Opus 5, Gemini 4 Argon and DeepSeek V4.1 Flash in four arms (second source shown: three samples). The second-source column includes the one protein AlphaFold DB does not cover, whose old sequence matches a current RefSeq or Ensembl model (9 runs, all relayed); Supplementary Tables 12 and 13 exclude it and so count 701 runs.}}{13}{table.19}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {20}{\ignorespaces Runs without a parseable answer: every cell with at least two, with the reported rate (unparsed runs excluded) and the rate with unparsed runs counted against the agent (as relayed for relay, as wrong for accuracy).}}{14}{table.20}\protected@file@percent }
