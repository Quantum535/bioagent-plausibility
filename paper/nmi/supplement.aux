\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Deployment experiment, first run (October 2026) and rerun (3 November 2026). Relay is relayed/delivered runs; the odds ratio compares relay of plausible values on exact-route fields with other fields (registered test, task-clustered logistic regression, 95\% interval). Audit columns count runs matching each pattern.}}{2}{table.1}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Prompt variants: wrong value relayed (relayed/parsed runs) under the registered default prompt and three variants, on (a) protein tasks whose full record contradicts the value, (b) the chemistry agreement cell (three samples) and (c) coherent protein errors. The last column gives, for the two-fields variant, runs in which the stated database value matched the record (scored on (a) and (b)).}}{2}{table.2}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Repetition versus consistency: wrong molecular weight relayed (relayed/parsed runs; 60 compounds, three samples, full record). R0, weight alone; R1, a verbatim repeat field scaled with the weight; R2, the repeat left correct; B, the heavy-atom count scaled with the weight. On uncorrupted records with the repeat field present, every model answered correctly in 60 of 60 runs. Pooled discordant pairs for RC1 (R0 relayed and R1 not, against the reverse): 198 against 84, two-sided McNemar $p = 10^{-11}$; for RC3 (R2 against R0), $p = 3 \times 10^{-144}$.}}{2}{table.3}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Memory probe on the 79 historical proteins. Memory state is the model's answer, without tools, for the protein's length: current (within one residue of today's length), superseded (within one of the superseded length), either (both, where they differ by at most two) or other. Relay of the superseded value is given as relayed/runs by memory state, without a second source (full record, one sample) and with the second source shown (annotate arm, three samples); $p$ is the registered one-sided Fisher test of superseded-memory against current-memory relay with the second source.}}{3}{table.4}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Withholding harness (full record, 100 tasks per domain and condition, one sample): corrupted numeric fields and identifiers relayed (relayed/parsed runs), runs without a parseable answer, and runs answered with a value that was neither the true nor the corrupted one. The last column gives identifier relay in the annotate arm of the benchmark (summary record) for comparison; the arms differ in record format.}}{3}{table.5}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Deployment rerun (Fig.~1b, c): corrupted values relayed by field (relayed/delivered runs) and, among relayed runs, how many raised a concern.}}{5}{table.6}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces Benchmark (Fig.~2): corrupted values relayed, runs raising a concern, and relayed runs that raised a concern (summary record, registered prompt, one sample).}}{6}{table.7}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces Override boundaries (Fig.~3), value decreased: corrupted value relayed (relayed/parsed runs) at each corruption factor, full record, paired field scaled alike.}}{7}{table.8}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces Override boundaries (Fig.~3), value increased: corrupted value relayed (relayed/parsed runs) at each corruption factor, full record, paired field scaled alike.}}{7}{table.9}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {10}{\ignorespaces New chemistry fields with the full record (Fig.~4a): runs raising a concern and corrupted values relayed, by field and condition.}}{8}{table.10}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {11}{\ignorespaces Agreement follow-up (Fig.~4b, c): wrong value relayed on the same 60 compounds, pooled over three samples and per sample.}}{9}{table.11}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {12}{\ignorespaces Historical UniProt errors (Fig.~5): superseded value relayed with the full and summary record (one sample), full-record repeats (three samples), and with AlphaFold DB as second source (annotate arm, three samples) on covered proteins, by direction of the revision, and on the uncovered protein.}}{9}{table.12}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {13}{\ignorespaces Presentation of the correction (Fig.~6): superseded value relayed on covered proteins under four presentations, pooled over three samples and per sample.}}{9}{table.13}\protected@file@percent }
